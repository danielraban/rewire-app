# Names only. Never commit values.
DATABASE_URL=            # owner role: migrations only
WEB_DATABASE_URL=        # rewire_web role (read-only); falls back to DATABASE_URL
SENTINEL_DATABASE_URL=   # rewire_sentinel role; falls back to DATABASE_URL
RPC_URL=                 # your own mainnet RPC; the public one rate-limits
CRON_SECRET=             # Vercel Cron sends it as a bearer token
